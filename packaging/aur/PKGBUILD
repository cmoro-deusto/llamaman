# Maintainer: Carlos Moro <carlos@gondor.es>
pkgname=llamaman-bin
pkgver=0.3.0
pkgrel=1
pkgdesc="TUI manager for llama-server (llama.cpp). Pre-built binary release."
arch=('x86_64' 'aarch64')
url="https://github.com/cmoro-deusto/llamaman"
license=('MIT')
provides=('llamaman')
conflicts=('llamaman')
depends=()
optdepends=(
  'wl-clipboard: clipboard support on Wayland'
  'xclip: clipboard support on X11'
  'llama.cpp: provides the llama-server binary'
)

source_x86_64=("$url/releases/download/v$pkgver/llamaman_${pkgver}_linux_amd64.tar.gz")
source_aarch64=("$url/releases/download/v$pkgver/llamaman_${pkgver}_linux_arm64.tar.gz")

# Replace these with the published checksums when tagging.
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  install -Dm755 "$srcdir/llamaman" "$pkgdir/usr/bin/llamaman"
  if [ -f "$srcdir/LICENSE" ]; then
    install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  fi
  if [ -f "$srcdir/README.md" ]; then
    install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  fi

  # Shell completions.
  install -d "$pkgdir/usr/share/bash-completion/completions"
  install -d "$pkgdir/usr/share/zsh/site-functions"
  install -d "$pkgdir/usr/share/fish/vendor_completions.d"
  "$pkgdir/usr/bin/llamaman" --completion bash > "$pkgdir/usr/share/bash-completion/completions/llamaman" || true
  "$pkgdir/usr/bin/llamaman" --completion zsh  > "$pkgdir/usr/share/zsh/site-functions/_llamaman"      || true
  "$pkgdir/usr/bin/llamaman" --completion fish > "$pkgdir/usr/share/fish/vendor_completions.d/llamaman.fish" || true
}
